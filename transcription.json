      "image": 1,
      "sides": [
        {
          "side": "right",
          "columns": [
            {
              "text": "法國巴黎城有瘋人"
            },
            {
              "text": "院一所凡在內"
            },
            {
              "text": "就醫者動至千餘"
            },
            {
              "text": "名各以房禁之"
            },
            {
              "text": "使不能發狂滋擾一"
            },
            {
              "text": "日不知緣何失察"
            },
            {
              "text": "各瘋人皆脫絆而出"
            },
            {
              "text": "爭取院中刀斧"
            },
            {
              "text": "向空亂舞更有躍上"
            },
            {
              "text": "屋脊拋瓦礫以"
            },
            {
              "text": "擊人者司事等奔"
            },
            {
              "text": "避不遑頻受其"
            },
            {
              "text": "害幸院門堅固牆壁"
            }
          ],
          "extras": [
            {
              "type": "article-title",
              "location": "篇題，分排依右起",
              "text": "瘋人難防",
              "rect": [
                1968,
                422,
                2230,
                567
              ]
            }
          ]
        },
        {
          "side": "left",
          "columns": [
            {
              "text": "峻高不至逃出"
            },
            {
              "text": "院外旋為地"
            },
            {
              "text": "方有司"
            },
            {
              "text": "所聞即"
            },
            {
              "text": "命救火局"
            },
            {
              "text": "諸人駕水龍"
            },
            {
              "text": "而至射之以水詎水懦"
            },
            {
              "text": "易狎各瘋人不"
            },
            {
              "text": "以為懼反以為喜手"
            },
            {
              "text": "舞足蹈直衝而"
            },
            {
              "text": "來乃改命礮兵一隊以"
            },
            {
              "text": "有藥無彈之槍"
            },
            {
              "text": "向之轟擊霎時間烟"
            },
            {
              "text": "燄迷漫瘋人始"
            },
            {
              "text": "狙伏一隅不敢復動繼"
            },
            {
              "text": "迺使強有力者"
            },
            {
              "text": "入院擒縛始得就獲仍"
            },
            {
              "text": "歸禁所然則防範"
            },
            {
              "text": "之道其可忽乎哉"
            }
          ],
